NODE_ENV=development
PORT=5000

CORS_ORIGINS=http://localhost:4200,http://localhost:4000

# Mapbox API Configuration
MAPBOX_TOKEN=pk.sample_mapbox_token_for_alm
MAPBOX_TIMEOUT_MS=10000

# OpenAI GPT-4o Vision Configuration
OPENAI_API_KEY=sk-sample_openai_key_for_alm_vision
OPENAI_VISION_MODEL=gpt-4o
OPENAI_TIMEOUT_MS=30000

# AWS S3 Document Storage
AWS_REGION=eu-west-1
AWS_S3_BUCKET=logistic-alm-epod-documents
AWS_ACCESS_KEY_ID=AKIA_SAMPLE_ALM_STORAGE_KEY
AWS_SECRET_ACCESS_KEY=sample_secret_key_alm_storage
S3_SERVER_SIDE_ENCRYPTION=AES256

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/alm_logistics?schema=public

LOG_LEVEL=info
