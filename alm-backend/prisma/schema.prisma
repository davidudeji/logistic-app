generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
}

enum EmailMessageStatus {
  queued
  sent
  delivered
  bounced
  complained
  failed
}

model Company {
  id           String     @id @default(cuid())
  tenantId     String
  name         String
  billingEmail String?
  address      String?
  customers    Customer[]
  invoices     Invoice[]

  @@unique([tenantId, id])
  @@index([tenantId])
}

model Customer {
  id        String    @id @default(cuid())
  tenantId  String
  companyId String
  name      String
  email     String?
  address   String?
  tin       String?
  company   Company   @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict)
  invoices  Invoice[]

  @@unique([tenantId, id])
  @@index([tenantId, companyId])
}

model Invoice {
  id         String         @id @default(cuid())
  tenantId   String
  companyId  String
  customerId String
  number     String?
  status     InvoiceStatus  @default(DRAFT)
  dueDate    DateTime       @db.Date
  pdfBytes   Bytes?
  createdAt  DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime       @updatedAt @db.Timestamptz(3)
  company    Company        @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict)
  customer   Customer       @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict)
  emails     EmailMessage[]

  @@unique([tenantId, id])
  @@unique([tenantId, number])
  @@index([tenantId, status])
}

model EmailMessage {
  id         String             @id @default(cuid())
  tenantId   String
  documentId String
  toEmail    String
  status     EmailMessageStatus @default(queued)
  resendId   String?            @unique
  error      String?
  createdAt  DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime           @updatedAt @db.Timestamptz(3)
  invoice    Invoice            @relation(fields: [tenantId, documentId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, documentId, createdAt])
  @@index([tenantId, createdAt])
}

model LocationPoint {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  jobId      String   @map("job_id")
  vehicleId  String   @map("vehicle_id")
  lat        Float
  lng        Float
  accuracy   Float
  speed      Float?
  heading    Float?
  recordedAt DateTime @db.Timestamptz(3) @map("recorded_at")
  createdAt  DateTime @default(now()) @db.Timestamptz(3) @map("created_at")

  @@index([jobId, recordedAt])
  @@index([tenantId, jobId, recordedAt])
  @@index([vehicleId, recordedAt])
  @@map("location_points")
}

model PublicTrackingToken {
  tokenHash String    @id @map("token_hash")
  tenantId  String    @map("tenant_id")
  jobId     String    @map("job_id")
  createdAt DateTime  @default(now()) @db.Timestamptz(3) @map("created_at")
  expiresAt DateTime? @db.Timestamptz(3) @map("expires_at")
  revokedAt DateTime? @db.Timestamptz(3) @map("revoked_at")

  @@index([tenantId, jobId])
  @@map("public_tracking_tokens")
}
